  <!-- Flush Visual Mockups (Pure block elements, ZERO bottom margin or padding) -->
  <div class="w-full m-0 p-0 leading-none">
    <div class="w-full overflow-hidden leading-none">
      <img
        src="/images/08.webp"
        alt="Mobile UI Showcase"
        class="w-full h-auto block object-cover"
        loading="lazy"
      />
    </div>

    <!-- Final image: flush against the bottom cut -->
    <div class="w-full overflow-hidden leading-none m-0 p-0">
      <img
        src="/images/10.webp"
        alt="Hill Legal Practice Digital Platform Showcase on Tablet"
        class="w-full h-auto block object-cover m-0 p-0"
        loading="lazy"
      />
    </div>
  </div>

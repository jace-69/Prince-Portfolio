---
// src/components/Hero.astro
---

<section 
  id="home" 
  class="sticky top-0 z-10 w-full h-screen min-h-[600px] bg-black text-white flex items-center px-6 sm:px-8 select-none overflow-hidden origin-center will-change-transform"
>
  <!-- 50% Desktop Asymmetrical Grid -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-12 items-center">
    
    <!-- Left Negative Space -->
    <div class="hidden lg:block lg:col-span-6" aria-hidden="true"></div>

    <!-- Right Column -->
    <div class="w-full lg:col-span-6 flex flex-col items-center lg:items-start">
      
      <!-- Bound Container -->
      <div class="relative w-fit flex flex-col items-start">
        
        <!-- Headline: Animates UP on load -->
        <h1 class="hero-title text-[19vw] lg:text-[12vw] font-normal tracking-[-0.035em] leading-[0.85] text-white uppercase select-none">
          PRINCE
        </h1>

        <!-- Bio Statement: Animates UP on load with subtle delay -->
        <div class="w-full flex justify-end pt-5 sm:pt-6 pr-2 sm:pr-4">
          <p class="hero-bio text-xs sm:text-[13px] md:text-sm text-[#8E8E93] text-left leading-[1.55] sm:leading-[1.6] font-normal tracking-normal max-w-[270px] sm:max-w-[295px] md:max-w-[310px]">
            <span class="inline-block w-7 sm:w-9"></span>I craft clean, modern<br />
            digital experiences that help<br />
            brands tell their story with clarity<br />
            and purpose.
          </p>
        </div>

      </div>

    </div>
  </div>

  <!-- Bottom Right Scroll Cue Arrow -->
  <div class="hero-cue absolute bottom-6 sm:bottom-8 right-6 sm:right-8 z-10">
    <a 
      href="#works" 
      aria-label="Scroll down to works" 
      class="text-[#8E8E93] hover:text-white transition-colors duration-200 block p-1"
    >
      <svg 
        class="w-3.5 h-3.5 sm:w-4 sm:h-4" 
        fill="none" 
        stroke="currentColor" 
        stroke-width="1.5" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
      </svg>
    </a>
  </div>
</section>

<style>
  /* --- Entrance Animation: Upward Slide --- */
  @keyframes heroUp {
    0% {
      opacity: 0;
      transform: translateY(35px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title {
    animation: heroUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .hero-bio {
    animation: heroUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .hero-cue {
    animation: heroUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  /* --- Scroll Curtain Dimming --- */
  @keyframes hero-slide-under {
    to {
      transform: scale(0.96);
      opacity: 0.35;
    }
  }

  @supports (animation-timeline: scroll()) {
    #home {
      animation: hero-slide-under linear both;
      animation-timeline: scroll();
      animation-range: 0px 100vh;
    }
  }
</style>

<script>
  // Prevents the Hero from ever ghosting over 'About' or lower sections
  const heroSection = document.getElementById('home');
  if (heroSection) {
    const handleScroll = () => {
      // Once scrolled past 1 full screen (Works has covered Hero), hide Hero completely
      if (window.scrollY >= window.innerHeight) {
        heroSection.style.visibility = 'hidden';
      } else {
        heroSection.style.visibility = 'visible';
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>
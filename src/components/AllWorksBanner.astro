---
interface Props {
  href?: string;
  label?: string;
  image?: string;
}

const {
  href = "/works",
  label = "All works",
  image = "/images/17.webp",
} = Astro.props;

// Split label for the staggered character cascade
const characters = label.split("");
---

<section
  id="all-works-section"
  class="relative w-full h-[60vh] sm:h-[75vh] md:h-[85vh] lg:h-[95vh] bg-black select-none overflow-hidden group"
>
  <!-- Architectural Corner Crosshairs (+) -->
  <span class="absolute top-6 left-6 sm:top-8 sm:left-8 text-neutral-500 font-mono text-xs select-none pointer-events-none z-20">+</span>
  <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-neutral-500 font-mono text-xs select-none pointer-events-none z-20">+</span>
  <span class="absolute bottom-6 left-6 sm:bottom-8 sm:left-8 text-neutral-500 font-mono text-xs select-none pointer-events-none z-20">+</span>
  <span class="absolute bottom-6 right-6 sm:bottom-8 sm:right-8 text-neutral-500 font-mono text-xs select-none pointer-events-none z-20">+</span>

  <!-- Background Imagery (Starts color, dynamically desaturates on proximity) -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      id="all-works-bg-img"
      src={image}
      alt="Prince Nkah — Works Archive Editorial Cover"
      class="w-full h-full object-cover object-center filter grayscale-0 contrast-100 brightness-100 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] will-change-[filter,transform]"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Editorial Vignette Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/50 pointer-events-none" />

  <!-- Centered Interactive FLIP Action Stage -->
  <div class="absolute inset-0 flex items-center justify-center z-10 p-6">
    <a
      id="flip-link"
      href={href}
      class="flip-trigger relative inline-flex flex-col items-center justify-center cursor-pointer py-6 px-10 group/link"
      aria-label={`${label} - Archive`}
    >
      <!-- FLIP Layout Morphing Glass Pill -->
      <div
        id="flip-pill"
        class="flip-pill absolute inset-0 rounded-full border border-white/20 bg-neutral-950/80 backdrop-blur-xl opacity-0 transition-opacity duration-300 group-hover/link:opacity-100 will-change-transform shadow-[0_16px_40px_rgba(0,0,0,0.5)]"
      ></div>

      <!-- Main Staggered Rolling FLIP Text & Arrow -->
      <div class="relative z-10 flex items-center gap-3 sm:gap-5 py-1">
        
        <!-- THE FIX: overflow-hidden & leading-[1.05] ensures ONLY 1 line is ever visible -->
        <span class="relative block overflow-hidden leading-[1.05] text-5xl sm:text-7xl md:text-8xl lg:text-[6.5rem] font-normal tracking-[-0.035em] text-white">
          
          <!-- Top Row (Slides up and out of the overflow box on hover) -->
          <span class="row-visible inline-flex">
            {characters.map((char, index) => (
              <span
                class="char inline-block transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/link:-translate-y-full"
                style={`transition-delay: ${index * 22}ms;`}
              >
                {char === " " ? "\u00A0" : char}
              </span>
            ))}
          </span>

          <!-- Bottom Row (Positioned below the box, slides into the overflow box on hover) -->
          <span class="row-incoming absolute inset-0 inline-flex pointer-events-none" aria-hidden="true">
            {characters.map((char, index) => (
              <span
                class="char inline-block translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/link:translate-y-0"
                style={`transition-delay: ${index * 22}ms;`}
              >
                {char === " " ? "\u00A0" : char}
              </span>
            ))}
          </span>
        </span>

        <!-- High-Contrast Architectural Arrow -->
        <div class="relative z-10 flex items-center justify-center w-8 h-8 sm:w-11 sm:h-11 md:w-13 md:h-13 flex-shrink-0">
          <svg
            class="w-7 h-7 sm:w-9 sm:h-9 md:w-11 md:h-11 text-white transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/link:translate-x-1.5 group-hover/link:-translate-y-1.5 drop-shadow-md"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </div>

      <!-- Subtitle Label -->
      <span class="relative z-10 mt-3 font-mono text-[10px] sm:text-xs tracking-[0.2em] text-neutral-400 uppercase opacity-60 group-hover/link:opacity-100 transition-opacity duration-300">
        ( VIEW ARCHIVE )
      </span>
    </a>
  </div>
</section>

<style>
  .flip-trigger {
    -webkit-font-smoothing: antialiased;
    transform: translateZ(0);
  }
</style>

<script>
  function initAllWorksInteractions() {
    const section = document.getElementById('all-works-section');
    const trigger = document.getElementById('flip-link');
    const pill = document.getElementById('flip-pill');
    const bgImg = document.getElementById('all-works-bg-img');

    if (!section || !trigger || !pill || !bgImg) return;

    // ========================================================
    // 1. THE FLIP TECHNIQUE (First, Last, Invert, Play)
    // ========================================================
    let isExpanded = false;

    trigger.addEventListener('mouseenter', () => {
      if (isExpanded) return;

      // FIRST: Record initial bounding box
      const first = pill.getBoundingClientRect();

      // LAST: Apply expanded padding & measure
      isExpanded = true;
      pill.style.transform = 'none';
      const isMobile = window.innerWidth < 640;
      pill.style.inset = isMobile ? '-10px -22px' : '-16px -36px';
      const last = pill.getBoundingClientRect();

      // INVERT: Calculate deltas
      const deltaX = first.left - last.left;
      const deltaY = first.top - last.top;
      const deltaW = first.width / (last.width || 1);
      const deltaH = first.height / (last.height || 1);

      pill.style.transformOrigin = 'center center';
      pill.style.transition = 'none';
      pill.style.transform = `translate3d(${deltaX.toFixed(2)}px, ${deltaY.toFixed(2)}px, 0px) scale(${deltaW.toFixed(3)}, ${deltaH.toFixed(3)})`;

      // PLAY: Release to identity on GPU compositor
      requestAnimationFrame(() => {
        pill.style.transition = 'transform 450ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease';
        pill.style.transform = 'translate3d(0px, 0px, 0px) scale(1, 1)';
      });
    });

    trigger.addEventListener('mouseleave', () => {
      if (!isExpanded) return;

      const first = pill.getBoundingClientRect();
      isExpanded = false;
      pill.style.transform = 'none';
      pill.style.inset = '0px 0px';
      const last = pill.getBoundingClientRect();

      const deltaX = first.left - last.left;
      const deltaY = first.top - last.top;
      const deltaW = first.width / (last.width || 1);
      const deltaH = first.height / (last.height || 1);

      pill.style.transition = 'none';
      pill.style.transform = `translate3d(${deltaX.toFixed(2)}px, ${deltaY.toFixed(2)}px, 0px) scale(${deltaW.toFixed(3)}, ${deltaH.toFixed(3)})`;

      requestAnimationFrame(() => {
        pill.style.transition = 'transform 380ms cubic-bezier(0.16, 1, 0.3, 1), opacity 250ms ease';
        pill.style.transform = 'translate3d(0px, 0px, 0px) scale(1, 1)';
      });
    });

    // ========================================================
    // 2. SMOOTH PROXIMITY-BASED GRAYSCALE PHYSICS
    // ========================================================
    let currentGrayscale = 0;
    let targetGrayscale = 0;
    let animationFrameId: number | null = null;

    function renderGrayscaleLoop() {
      const diff = targetGrayscale - currentGrayscale;
      if (Math.abs(diff) > 0.002) {
        currentGrayscale += diff * 0.07;
        const contrast = 1.0 + currentGrayscale * 0.15;
        const brightness = 1.0 - currentGrayscale * 0.22;

        bgImg.style.filter = `grayscale(${(currentGrayscale * 100).toFixed(1)}%) contrast(${contrast.toFixed(2)}) brightness(${brightness.toFixed(2)})`;
        animationFrameId = requestAnimationFrame(renderGrayscaleLoop);
      } else {
        currentGrayscale = targetGrayscale;
        const contrast = 1.0 + currentGrayscale * 0.15;
        const brightness = 1.0 - currentGrayscale * 0.22;
        bgImg.style.filter = `grayscale(${(currentGrayscale * 100).toFixed(1)}%) contrast(${contrast.toFixed(2)}) brightness(${brightness.toFixed(2)})`;
        animationFrameId = null;
      }
    }

    function wakeGrayscaleLoop() {
      if (!animationFrameId) {
        animationFrameId = requestAnimationFrame(renderGrayscaleLoop);
      }
    }

    section.addEventListener('pointermove', (e: PointerEvent) => {
      const triggerRect = trigger.getBoundingClientRect();
      const centerX = triggerRect.left + triggerRect.width / 2;
      const centerY = triggerRect.top + triggerRect.height / 2;

      const distance = Math.hypot(e.clientX - centerX, e.clientY - centerY);
      const maxRadius = Math.max(window.innerWidth * 0.32, 420);

      if (distance < maxRadius) {
        const factor = 1 - distance / maxRadius;
        targetGrayscale = factor * factor * (3 - 2 * factor);
      } else {
        targetGrayscale = 0;
      }

      wakeGrayscaleLoop();
    });

    section.addEventListener('pointerleave', () => {
      targetGrayscale = 0;
      wakeGrayscaleLoop();
    });
  }

  document.addEventListener('DOMContentLoaded', initAllWorksInteractions);
  document.addEventListener('astro:page-load', initAllWorksInteractions);
</script>
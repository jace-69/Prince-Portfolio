---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Prince Nkah | Portfolio", 
  description = "Minimalist, high-performance portfolio and digital design engineering." 
} = Astro.props;

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-[#EDEDED] min-h-screen flex flex-col selection:bg-white selection:text-black antialiased">
    <!-- Dynamic Adapting Navbar -->
    <Navbar />
    
    <main class="flex-grow w-full">
      <slot />
    </main>
  </body>
</html>
---
import Layout from '../layouts/Layout.astro';
import AllWorksBanner from '../components/AllWorksBanner.astro';
import Footer from '../components/Footer.astro';

const emailAddress = "princenkah@gmail.com";
const whatsappNumber = "+1 (231) 660-4032";
---

<Layout title="Contact & Mail | Prince Nkah">
  <!-- Mail Hero & Interactive Action Pills -->
  <section class="w-full bg-black text-white pt-36 sm:pt-44 md:pt-48 pb-20 sm:pb-28 px-6 sm:px-10 md:px-14 flex flex-col items-center justify-center select-none overflow-hidden">
    <!-- Giant Mail Headline (Masked Entrance Wipe) -->
    <div class="overflow-hidden">
      <h1 class="contact-title text-7xl sm:text-8xl md:text-9xl lg:text-[14rem] font-normal tracking-[-0.04em] leading-[0.88] text-white text-center">
        DMs
      </h1>
    </div>

    <!-- Action Buttons Stack (Staggered Upward Glide) -->
    <div class="contact-actions flex flex-col items-center space-y-3 mt-10 sm:mt-14">
      <!-- Copy Email Pill -->
      <button
        type="button"
        id="copy-email-btn"
        data-email={emailAddress}
        class="border border-neutral-700 hover:border-white px-6 sm:px-7 py-2 sm:py-2.5 rounded-full text-xs sm:text-[13px] font-normal text-white transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer bg-neutral-950/40"
      >
        Email
      </button>

      <!-- Copy Number (Whatsapp) Pill -->
      <button
        type="button"
        id="copy-phone-btn"
        data-phone={whatsappNumber}
        class="border border-neutral-700 hover:border-white px-6 sm:px-7 py-2 sm:py-2.5 rounded-full text-xs sm:text-[13px] font-normal text-white transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer bg-neutral-950/40"
      >
        Whatsapp
      </button>
    </div>
  </section>

  <!-- Full-Bleed Portal Banner to Works -->
  <AllWorksBanner />

  <!-- Monolithic Signature Footer -->
  <Footer />
</Layout>

<style>
  /* --- Headline Upward Masked Wipe --- */
  @keyframes contactWipeUp {
    0% {
      transform: translate3d(0, 100%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* --- Action Pills Staggered Float In --- */
  @keyframes contactFadeUp {
    0% {
      opacity: 0;
      transform: translate3d(0, 28px, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .contact-title {
    animation: contactWipeUp 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .contact-actions {
    animation: contactFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both;
  }
</style>

<script>
  function setupClipboard() {
    const emailBtn = document.getElementById('copy-email-btn');
    const phoneBtn = document.getElementById('copy-phone-btn');

    if (emailBtn) {
      emailBtn.addEventListener('click', async () => {
        const email = emailBtn.getAttribute('data-email') || '';
        try {
          await navigator.clipboard.writeText(email);
          const original = emailBtn.innerText;
          emailBtn.innerText = 'Copied to Clipboard!';
          emailBtn.classList.add('border-white', 'bg-white', 'text-black');
          emailBtn.classList.remove('text-white');
          setTimeout(() => {
            emailBtn.innerText = original;
            emailBtn.classList.remove('border-white', 'bg-white', 'text-black');
            emailBtn.classList.add('text-white');
          }, 2000);
        } catch (e) {
          window.location.href = `mailto:${email}`;
        }
      });
    }

    if (phoneBtn) {
      phoneBtn.addEventListener('click', async () => {
        const phone = phoneBtn.getAttribute('data-phone') || '';
        try {
          await navigator.clipboard.writeText(phone);
          const original = phoneBtn.innerText;
          phoneBtn.innerText = 'Copied to Clipboard!';
          phoneBtn.classList.add('border-white', 'bg-white', 'text-black');
          phoneBtn.classList.remove('text-white');
          setTimeout(() => {
            phoneBtn.innerText = original;
            phoneBtn.classList.remove('border-white', 'bg-white', 'text-black');
            phoneBtn.classList.add('text-white');
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupClipboard);
  } else {
    setupClipboard();
  }
  document.addEventListener('astro:page-load', setupClipboard);
</script>
---
import Layout from '../layouts/Layout.astro';
import AllWorksBanner from '../components/AllWorksBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — Page Not Found | Prince Nkah">
  <!-- Persistent Floating Header -->
  <header class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-6 sm:px-10 md:px-14 py-7 text-xs sm:text-[13px] text-white select-none bg-black/80 backdrop-blur-md">
    <!-- Brand / Name (Top Left) -->
    <div>
      <a href="/" class="font-medium tracking-tight text-white hover:opacity-75 transition-opacity">
        Prince Nkah
      </a>
    </div>

    <!-- Center Nav -->
    <nav class="hidden lg:flex items-center space-x-8 text-neutral-400 absolute left-1/2 -translate-x-1/2">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <a href="/works" class="hover:text-white transition-colors">Works</a>
      <a href="/#about" class="hover:text-white transition-colors">About</a>
    </nav>

    <!-- Contact CTA (Top Right) -->
    <div>
      <a href="/contact" class="hover:text-neutral-300 transition-colors tracking-tight">
        Let's talk
      </a>
    </div>
  </header>

  <!-- 404 Error Centerpiece -->
  <section class="w-full bg-black text-white pt-36 sm:pt-44 md:pt-48 pb-20 sm:pb-28 px-6 sm:px-10 md:px-14 flex flex-col items-center justify-center select-none overflow-hidden">
    <!-- Giant 404 Headline -->
    <h1 class="text-8xl sm:text-9xl md:text-[14rem] lg:text-[18vw] font-normal tracking-[-0.04em] leading-[0.85] text-white text-center">
      404
    </h1>

    <!-- Subtitle Notice -->
    <p class="text-xs sm:text-[13px] text-neutral-400 text-center max-w-[280px] sm:max-w-[320px] leading-relaxed font-light mt-6 sm:mt-8">
      Ooops! Looks like the page you're looking for doesn't exist or has been moved.
    </p>

    <!-- Return Home Anchor -->
    <a
      href="/"
      class="mt-4 text-xs sm:text-[13px] text-white underline underline-offset-4 decoration-neutral-600 hover:decoration-white transition-colors font-normal"
    >
      Return home
    </a>
  </section>

  <!-- Full-Bleed Portal Banner to Works -->
  <AllWorksBanner />

  <!-- Monolithic Signature Footer -->
  <Footer />
</Layout>